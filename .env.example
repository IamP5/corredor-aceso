# Copie para .env e preencha. O .env nunca entra no Git.
# Chave do OpenRouter, usada pelo módulo Guarda para traduzir eventos de segurança.
# Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo usado na tradução. "openrouter/auto" deixa o OpenRouter escolher.
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
