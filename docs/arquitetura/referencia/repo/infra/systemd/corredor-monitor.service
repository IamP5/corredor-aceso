[Unit]
Description=Corredor Aceso - monitor de CPU, memória, disco e serviços
After=network.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
User=corredor-mon
Group=corredor-mon
EnvironmentFile=-/etc/corredor/monitor.env
ExecStart=/bin/bash /usr/local/lib/corredor/monitor.sh
Restart=always
RestartSec=3
WatchdogSec=60
SyslogIdentifier=corredor-monitor
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/corredor/monitor

[Install]
WantedBy=multi-user.target
