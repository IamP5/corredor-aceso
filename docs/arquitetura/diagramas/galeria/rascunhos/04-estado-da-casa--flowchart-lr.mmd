  r3{"R3 calor, com<br/>turno aberto?"}
  r4{"R4 sem sinal na<br/>janela vencida?"}
  vida{"sinal de vida na<br/>janela atual?"}
  verm1["Vermelho<br/>EnergiaEletrodependente"]:::alerta
  cinza["Cinza<br/>SemHeartbeat"]:::cinza
  verm2["Vermelho<br/>CalorInterno"]:::alerta
  verm3["Vermelho<br/>SemMovimentoNaJanela"]:::alerta
  verde["Verde"]:::verde
  aguarda["Aguardando"]
