%% VM corredor-ubs e seus serviços. Fonte: 05-infra-e-entrega.md, seções 1.8 a 1.11, 2 e 4.4, e as units de referencia/repo/infra/systemd.
flowchart LR
  app["App da ACS<br/>no celular"]:::externo
  cf["trycloudflare.com<br/>URL HTTPS temporária"]:::externo
  pub["broker.hivemq.com:1883<br/>broker MQTT público"]:::externo
  llm["LLM"]:::externo
  subgraph vm["VM corredor-ubs, Ubuntu 24.04. IP de serviço 10.77.0.1 em corredor0"]
    tunel["corredor-tunel.service<br/>cloudflared, ligado à mão"]
    nginx["nginx :80<br/>api.corredor.internal<br/>painel.corredor.internal"]
    api["corredor-api.service<br/>.NET 10, 127.0.0.1:5000<br/>Restart=on-failure"]:::luz
    painel["/opt/corredor/current/painel<br/>página estática"]
    mq["mosquitto 127.0.0.1:1883<br/>broker local e ponte de saída"]
    sim["corredor-simulador.service<br/>39 casas, ligado à mão"]
    pg[("postgresql em 127.0.0.1<br/>banco corredor: schemas<br/>motor, cadastro e guarda")]
    ml["corredor-ml.timer, 05h<br/>corredor-ml.service<br/>prever_hoje.py"]
    mon["corredor-monitor.service<br/>Restart=always<br/>WatchdogSec=60"]
    alerta["corredor-alerta@.service<br/>falha definitiva"]
    log[("/var/log/corredor<br/>monitor/alertas.log<br/>auditoria.log")]
  end
  app -- "HTTPS" --> cf
  cf -- "túnel" --> tunel
  tunel -- "http, porta 80" --> nginx
  nginx -- "/api" --> api
  nginx -- "/painel/" --> painel
  pub <-- "ponte de saída" --> mq
  sim -- "MQTT" --> mq
  mq <-- "eventos e comandos" --> api
  api -- "um papel por módulo" --> pg
  ml -- "PUT /api/dias-criticos/{data}" --> api
  api -- "prompt sem dado pessoal" --> llm
  mon -- "/healthz/ready" --> api
  mon -- "alertas" --> log
  api -. "OnFailure" .-> alerta
  alerta --> log
  classDef luz stroke-width:2px
  classDef externo stroke-width:1px
