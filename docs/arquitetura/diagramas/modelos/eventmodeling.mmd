%% Modelo eventmodeling. Vistas: event storming (um diagrama por fluxo da sessão 2).
%% Regras: nomes no código, sem espaço (MovimentoDetectado). Evento com prefixo do contexto (Motor., Cadastro., Guarda.),
%% que vira uma raia "Eventos: Motor". Comando, leitura, tela e automação sem prefixo. Abra cada fatia nova com rf,
%% para o Pele não ligar o último quadro da fatia anterior ao primeiro desta. Leitura liga eventos com ->> número.
%% Corpo copiado de 10-event-storming-fluxo-3-dia-critico-manha.mmd.
eventmodeling

rf 01 pcr JobDePrevisao
tf 02 cmd DeclararDiaCritico { data; probabilidade; motivo; origem }
tf 03 evt Motor.DiaCriticoDeclarado
tf 04 evt Motor.TurnoAberto
tf 05 pcr AoDeclararDiaCritico
tf 06 evt Motor.ComandoDiaCriticoPublicado
rf 07 pcr NoDoCorredor
tf 08 cmd RegistrarPacote { tipo: MOVIMENTO }
tf 09 evt Motor.MovimentoDetectado
tf 10 evt Motor.CasaFicouVerde
rf 11 pcr NoDoCorredor
tf 12 cmd RegistrarPacote { tipo: BOTAO_SAIR }
tf 13 evt Motor.SaidaAvisada
rf 14 rmo Radar ->> 10 ->> 13
tf 15 ui AppDaACS
rf 16 pcr Relogio
tf 17 evt Motor.JanelaEncerrada
tf 18 evt Motor.CasaFicouVermelha
tf 19 pcr VigiaDoRadar
tf 20 cmd PedirContatoAsync { casaToken; motivo; desde }
tf 21 evt Motor.PedidoDeContatoEnviado
rf 22 ui AppDaACS
tf 23 cmd RegistrarVisita { desfecho: EstavaBem }
tf 24 evt Cadastro.VisitaRegistrada
tf 25 pcr TradutorDeDesfecho
tf 26 cmd Confirmar { origem: Acs; resultado: PessoaVista }
tf 27 evt Motor.ConfirmacaoRegistrada
tf 28 rmo Radar ->> 27
