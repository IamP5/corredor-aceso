%% Modelo sequenceDiagram. Vistas: as três cenas da demo (uma sequência por cena) e o fluxo da Guarda.
%% Regras: até 8 participantes com o nome do código, autonumber, rota HTTP e tópico MQTT na mensagem ou numa Note,
%% resposta com -->>. Mensagem longa não quebra mais: a largura natural é o tamanho do texto.
sequenceDiagram
  autonumber
  participant no as Nó ESP32
  participant pub as Broker público
  participant mq as Mosquitto
  participant motor as Motor
  participant pg as Postgres
  actor acs as App da ACS
  Note over motor: dia crítico, turno aberto, casa vermelha
  no->>pub: corredor/v1/{casaToken}/evento MOVIMENTO
  pub->>mq: bridge
  mq->>motor: evento {seq, ts, tipo}
  motor->>pg: INSERT ON CONFLICT (casaToken, seq, ts)
  acs->>motor: GET /api/radar?microarea=7
  motor->>motor: AvaliadorDeCasas.Avaliar(casa, historico, turno, agora)
  motor-->>acs: vermelhos e cinzas, sem esta casa
  Note over acs: o card sai da tela
